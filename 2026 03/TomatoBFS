import java.util.Scanner;
public class tomatoBFS {
	public static void bfs(int[][] farm,int[][] q,int idx,int m,int n) {
		int[][] udlr= {{-1,0},{1,0},{0,-1},{0,1}};
		while(idx>0) {
			int cx=q[0][0];
			int cy=q[0][1];
			int day=q[0][2];
			System.out.println("day - " + q[0][2]);
			idx--;
			for(int i=0;i<idx;i++) {
				q[i][0]=q[i+1][0];
				q[i][1]=q[i+1][1];
				q[i][2]=q[i+1][2];
			}
			for(int i=0;i<4;i++) {
				int nx=cx+udlr[i][0];
				int ny=cy+udlr[i][1];
				if(nx>=0&&nx<n&&ny>=0&&ny<m&&farm[nx][ny]==0) {
					q[idx][0]=nx;
					q[idx][1]=ny;
					q[idx][2]=day+1;
					farm[nx][ny]=1;
					idx++;
				}
			}
		}
	}
	public static void main(String[] args) {
		Scanner s=new Scanner(System.in);
		int m=s.nextInt();
		int n=s.nextInt();
		int[][] farm=new int[n][m];
		for(int i=0;i<n;i++) {
			for(int j=0;j<m;j++) {
				farm[i][j]=s.nextInt();
			}
		}
		int[][] q=new int[farm.length*farm[0].length][3];
		int idx=0;
		for(int i=0;i<n;i++) {
			for(int j=0;j<m;j++) {
				if(farm[i][j]==1) {
					q[idx][0]=i;
					q[idx][1]=j;
					q[idx][2]=0;
					idx++;
				}
			}
		}
		bfs(farm,q,idx,m,n);
		System.out.println();
		for(int i=0;i<n;i++) {
			for(int j=0;j<m;j++) {
				System.out.print(farm[i][j] + " ");
			}
			System.out.println();
		}
		int check=0;
		for(int i=0;i<n;i++) {
			for(int j=0;j<m;j++) {
				if(farm[i][j]==0) {
					check=1;
				}
			}
		}
		if(check==1) {
			System.out.println("모든 토마토를 익히지 못했음");
		}
	}
}
