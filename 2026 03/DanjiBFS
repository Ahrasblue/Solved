import java.util.Scanner;
public class bfsDanji {
	public static int count[]=new int[100];
	public static void bfs(int board[][],int check[][],int x,int y,int danji) {
		int que[][]=new int[board.length][3];
		int pos[][]={{-1,0},{1,0},{0,-1},{0,1}};
		int idx=1;
		que[0][0]=x;
		que[0][1]=y;
		check[x][y]=danji;
		while(idx>0) {
			int curx=que[0][0];
			int cury=que[0][1];
			idx--;
			for(int i=0;i<idx;i++) {
				que[i][0]=que[i+1][0];
				que[i][1]=que[i+1][1];
			}
			for(int i=0;i<4;i++) {
				if(curx+pos[i][0]>=0&&curx+pos[i][0]<board.length&&cury+pos[i][1]>=0&&cury+pos[i][1]<board.length&&board[curx+pos[i][0]][cury+pos[i][1]]==1&&check[curx+pos[i][0]][cury+pos[i][1]]==0) {
					que[idx][0]=curx+pos[i][0];
					que[idx][1]=cury+pos[i][1];
					check[curx+pos[i][0]][cury+pos[i][1]]=danji;
					count[danji-1]++;
					idx++;
				}
			}
		}
	}
	public static void main(String[] args) {
		Scanner s=new Scanner(System.in);
		int n=s.nextInt();
		int board[][]=new int[n][n];
		int check[][]=new int[n][n];
		for(int i=0;i<n;i++) {
			for(int j=0;j<n;j++) {
				board[i][j]=s.nextInt();
			}
		}
		for(int i=0;i<n;i++) {
			for(int j=0;j<n;j++) {
				System.out.print(board[i][j] + " ");
			}
			System.out.println();
		}
		System.out.println();
		int danji=1;
		for(int i=0;i<n;i++) {
			for(int j=0;j<n;j++) {
				if(board[i][j]==1&&check[i][j]==0) {
					bfs(board,check,i,j,danji);
					danji++;
				}
			}
		}
		for(int k=0;k<n;k++) {
			for(int l=0;l<n;l++) {
				System.out.print(check[k][l] + " ");
			}
			System.out.println();
		}
		System.out.println(danji-1);
		for(int i=0;i<danji-1;i++) {
			System.out.println(count[i]+1);
		}
	}
}
