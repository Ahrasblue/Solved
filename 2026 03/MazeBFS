import java.util.Scanner;
public class MazeBFS {
	public static void bfs(int x,int y,int board[][]) {
		int q[][]=new int [board.length*board[0].length][3];
		int chk[][]=new int [board.length][board[0].length];
		int idx=1;
		int pos[][]= {{-1,0},{1,0},{0,-1},{0,1}};
		int cnt=1;
		q[0][0]=x;
		q[0][1]=y;
		q[0][2]=cnt;
		chk[x][y]=1;
		while(idx>0) {
			int curx=q[0][0];
			int cury=q[0][1];
			int curcnt=q[0][2];
			if(curx==board.length-1&&cury==board[0].length-1) {
				System.out.println("min = " + curcnt);
				break;
			}
			idx--;
			for(int i=0;i<idx;i++) {
				q[i][0]=q[i+1][0];
				q[i][1]=q[i+1][1];
				q[i][2]=q[i+1][2];
			}
			for(int i=0;i<4;i++) {
				if(curx+pos[i][0]>=0&&curx+pos[i][0]<board.length&&cury+pos[i][1]>=0&&cury+pos[i][1]<board[0].length&&board[curx+pos[i][0]][cury+pos[i][1]]==1&&chk[curx+pos[i][0]][cury+pos[i][1]]==0) {
					q[idx][0]=curx+pos[i][0];
					q[idx][1]=cury+pos[i][1];
					q[idx][2]=curcnt+1;
					chk[curx+pos[i][0]][cury+pos[i][1]]=1;
					idx++;
				}
			}
		}
	}
	public static void main(String[] args) {
		Scanner s = new Scanner(System.in);
		int n=s.nextInt();
		int m=s.nextInt();
		int[][] board=new int[n][m];
		System.out.println();
		for(int i=0;i<n;i++) {
			for(int j=0;j<m;j++) {
				int a=s.nextInt();
				board[i][j]=a;
			}
		}
		for(int i=0;i<n;i++) {
			for(int j=0;j<m;j++) {
				System.out.print(board[i][j] + " ");
			}
			System.out.println();
		}
		bfs(0,0,board);
	}
}
