import java.util.Scanner;
public class MazeDFS {
	static int min=100000000;
	static void re(int[][] board, int[][] check, int x, int y, int n, int m, int ans) {
		if(x==n-1&&y==m-1&&min>ans) {
			min=ans;
		}
		if(x<0||x>=n||y<0||y>=m||board[x][y]==0||check[x][y]==1) {
			return;
		}
		check[x][y]=1;
		re(board,check,x-1,y,n,m,ans+1);
		re(board,check,x+1,y,n,m,ans+1);
		re(board,check,x,y-1,n,m,ans+1);
		re(board,check,x,y+1,n,m,ans+1);
		check[x][y]=0;
	}
	public static void main(String[] args) {
		Scanner s = new Scanner(System.in);
		int n=s.nextInt();
		int m=s.nextInt();
		int[][] board=new int[n][m];
		int[][] check=new int[n][m];
		System.out.println();
		for(int i=0;i<n;i++) {
			for(int j=0;j<m;j++) {
				int a=s.nextInt();
				board[i][j]=a;
				check[i][j]=0;
			}
		}
		for(int i=0;i<n;i++) {
			for(int j=0;j<m;j++) {
				System.out.print(board[i][j] + " ");
			}
			System.out.println();
		}
		for(int i=0;i<n;i++) {
			for(int j=0;j<m;j++) {
				System.out.print(check[i][j] + " ");
			}
			System.out.println();
		}
		re(board,check,0,0,n,m,1);
		System.out.println("min = " + min);
	}
}
