import java.util.Scanner;
public class baechuBFS {
	public static void bfs(int[][] board,int[][] check,int x,int y) {
		int[][] q=new int[board.length*board[0].length][2];
		int[][] udlr={{-1,0},{1,0},{0,-1},{0,1}};
		int idx=1;
		q[0][0]=x;
		q[0][1]=y;
		check[x][y]=1;
		while(idx>0) {
			int cx=q[0][0];
			int cy=q[0][1];
			idx--;
			for(int i=0;i<idx;i++) {
				q[i][0]=q[i+1][0];
				q[i][1]=q[i+1][1];
			}
			for(int i=0;i<4;i++) {
				if(cx+udlr[i][0]>=0&&cx+udlr[i][0]<board.length&&cy+udlr[i][1]>=0&&cy+udlr[i][1]<board[0].length&&board[cx+udlr[i][0]][cy+udlr[i][1]]==1&&check[cx+udlr[i][0]][cy+udlr[i][1]]==0) {
					q[idx][0]=cx+udlr[i][0];
					q[idx][1]=cy+udlr[i][1];
					check[cx+udlr[i][0]][cy+udlr[i][1]]=1;
					idx++;
				}
			}
		}
	}
	public static void main(String[] args) {
		Scanner s=new Scanner(System.in);
		int m=s.nextInt();
		int n=s.nextInt();
		int k=s.nextInt();
		int[][] board=new int[m][n];
		int[][] check=new int[m][n];
		for(int i=0;i<k;i++) {
			int x=s.nextInt();
			int y=s.nextInt();
			board[x][y]=1;
		}
		System.out.println();
		for(int i=0;i<m;i++) {
			for(int j=0;j<n;j++) {
				System.out.print(board[i][j] + " ");
			}
			System.out.println();
		}
		int zirungyee=0;
		for(int i=0;i<m;i++) {
			for(int j=0;j<n;j++) {
				if(board[i][j]==1&&check[i][j]==0) {
					bfs(board,check,i,j);
					zirungyee++;
				}
			}
		}
		System.out.println();
		for(int i=0;i<m;i++) {
			for(int j=0;j<n;j++) {
				System.out.print(check[i][j] + " ");
			}
			System.out.println();
		}
		System.out.println("zirungyee - " + zirungyee);
	}
}
