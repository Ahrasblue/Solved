import java.util.*;
class Solution {
    public int solution(String message, int[][] spoiler_ranges) {
        int answer = 0;
        String[] a=message.split(" ");
        StringBuilder b=new StringBuilder(message);
        for(int i=0;i<spoiler_ranges.length;i++){
            for(int j=spoiler_ranges[i][0];j<=spoiler_ranges[i][1];j++){
                if(b.charAt(j)!=' ') b.setCharAt(j,'@');
            }
        }
        System.out.println(b);
        ArrayList<String> blind=new ArrayList<>(Arrays.asList(b.toString().split(" ")));
        for(int i=0;i<a.length;i++){
            int check=0;
            for(int j=0;j<blind.size();j++){
                if(a[i].equals(blind.get(j))){
                    check=1;
                    break;
                }
            }
            if(check==0){
                answer++;
                blind.add(a[i]);
            }
        }
        return answer;
    }
}
