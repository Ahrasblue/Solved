import java.util.Arrays;
import java.util.Collections;
import java.util.Comparator;

public class SmartSale {
	public static void main(String[] args) {
		int n=6;
		int m=3;
		int[] ids= {1,2,3,1,2,2};		
		
		int max=0;
		for(int i=0;i<n;i++) {
			if(ids[i]>max) {
				max=ids[i];
			}
		}
		int[][] board=new int[max+1][2];
		
		int count=0;
		for(int i=0;i<n;i++) {
			board[ids[i]][0]=ids[i];
			board[ids[i]][1]++;
		}
		
		Arrays.sort(board,new Comparator<int []>() {

			@Override
			public int compare(int[] o1, int[] o2) {
				return o1[1]-o2[1];
			}
		});
		
		for(int i=0;i<board.length;i++) {
			System.out.println(board[i][0] + " - " + board[i][1]);
		}System.out.println();
		
		for(int i=0;i<board.length;i++) {
			if(board[i][1]==0) {
				continue;
			}
			while(board[i][1]>0&&m>0) {
				m--;
				board[i][1]--;
			}
			if(m<1) {
				break;
			}
		}
		int result=0;
		for(int i=0;i<board.length;i++) {
			if(board[i][1]!=0) {
				result++;
			}
		}
		for(int i=0;i<board.length;i++) {
			System.out.println(board[i][0] + " - " + board[i][1]);
		}
		
		System.out.println("result - " + result);
	}
}
