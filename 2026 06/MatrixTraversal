int[][] mat= {{41,22,56,84},{22,51,1,20},{5,7,18,19},{11,22,3,15}};

int[][] mat= {{10,20,30,40},{60,50,20,80},{10,10,10,10},{60,50,60,50}};
 */
public class MatrixTraversal {
	public static void main(String[] args) {
		int[][] mat= {{41,22,56,84},{22,51,1,20},{5,7,18,19},{11,22,3,15}};
		
		int min=400;
		for(int i=0;i<4;i++) {
			int score=0;
			score+=mat[0][i];
			for(int j=0;j<4;j++) {
				if(i-1>j||i+1<j) {
					continue;
				}
				score+=mat[1][j];
				for(int k=0;k<4;k++) {
					if(j-1>k||j+1<k) {
						continue;
					}
					score+=mat[2][k];
					for(int l=0;l<4;l++) {
						if(k-1>l||k+1<l) {
							continue;
						}
						score+=mat[3][l];
						System.out.println("i - " + i + "  score - " + score);
						System.out.println("j - " + j + "  score - " + score);
						System.out.println("k - " + k + "  score - " + score);
						System.out.println("l - " + l + "  score - " + score);
						System.out.println("min - " + min);
						if(score<min) {
							min=score;
						}
						score-=mat[3][l];
						System.out.println();
					}
					score-=mat[2][k];
				}
				score-=mat[1][j];
			}
		}
		int result=100-min;
		System.out.println("result - " + result);
	}
}
