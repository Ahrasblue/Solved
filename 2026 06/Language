public class Language {
	public static void main(String[] args) {
		String[] table={"SI JAVA JAVASCRIPT SQL PYTHON C#",
			 	"CONTENTS JAVASCRIPT JAVA PYTHON SQL C++",
			 	"HARDWARE C C++ PYTHON JAVA JAVASCRIPT",
			 	"PORTAL JAVA JAVASCRIPT PYTHON KOTLIN PHP",
			 	"GAME C++ C# JAVASCRIPT C JAVA"};
		String[] languages={"JAVA","JAVASCRIPT"};
		int[] preference={7,5};
		
		int[] score=new int[5];
		String[][] table2=new String[5][6];
		
		for(int i=0;i<5;i++) {
			table2[i]=table[i].split(" ");
		}
		
		for(int i=0;i<5;i++) {
			for(int j=1;j<6;j++) {
				for(int k=0;k<languages.length;k++) {
					if(table2[i][j].equals(languages[k])) {
						score[i]+=(preference[k]*(5-j+1));
					}
				}
			}
		}
		
		int max=0;
		int[] maxidx= {999,999,999,999,999};
		int idx=1;
		for(int i=0;i<5;i++) {
			System.out.println(score[i]);
			if(score[i]>max) {
				max=score[i];
				maxidx[0]=i;
			}else if(score[i]==max) {
				maxidx[idx]=i;
				idx++;
			}
		}
		
		for(int i=0;i<5;i++) {
			System.out.println(maxidx[i]);
		}
		
		System.out.println("max = " + max);
		String z="Z";
		for(int i=0;i<idx;i++) {
			if(z.compareTo(table2[maxidx[i]][0])>0) {
				z=table2[maxidx[i]][0];
				System.out.println("z = " + z);
			}
		}
		System.out.println("return = " + z);
	}
}
