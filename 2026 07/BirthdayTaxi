public class BirthdayTaxi {
	public static void solution(int[] s) {
		int output=0;
		int[] people=new int[4];
		int taxi=0;
		
		for(int i=0;i<s.length;i++) {
			people[s[i]-1]++;
		}
		
		for(int i=0;i<4;i++) {
			System.out.println(people[i]);
		}
		
		taxi+=people[3];
		people[3]=0;
		
		while(people[0]>0&&people[2]>0) { // 1 + 3 결합
			taxi++;
			people[0]--;
			people[2]--;
		}
		
		while(people[1]>1) { // 2 + 2 결합
			taxi++;
			people[1]-=2;
		}
		
		while(people[0]>0&&people[1]>0) { // 1 + 2 결합
			taxi++;
			people[0]--;
			people[1]--;
		}
		
		for(int i=0;i<4;i++) {
			while(people[i]>0) {
				taxi++;
				people[i]--;
			}
		}
		
		System.out.println("taxi - " + taxi);
	}	
	public static void main(String[] args) {
		int[] s= {1,2,4,3,3};
		solution(s);
	}
}
