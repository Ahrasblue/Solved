public class GameServer {
	public static void main(String[] args) {
		int[] players={0,2,3,3,1,2,0,0,0,0,4,2,0,6,0,4,2,13,3,5,10,0,1,5};
		int m=3,k=5;
		
		int[] server=new int[24];
		int[] maxplayer=new int[24];
		int result=0;
		for(int i=0;i<24;i++) {
			maxplayer[i]=m;
		}
		for(int i=0;i<24;i++) {
			while(players[i]>=maxplayer[i]) {
				for(int j=i;j<i+k;j++) {
					if(j>23) {
						break;
					}
					server[j]++;
					maxplayer[j]+=m;
				}
				result++;
			}
		}
		for(int i=0;i<24;i++) {
			System.out.print(server[i] + " ");
		}
		System.out.println();
		System.out.println("result - " + result);
	}
}
